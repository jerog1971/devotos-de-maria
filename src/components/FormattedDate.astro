---
interface Props {
	date?: Date | string;
}

const { date } = Astro.props;
const parsedDate = date ? new Date(date) : new Date();
const isValid = !isNaN(parsedDate.getTime());
---

{
	isValid ? (
		<time datetime={parsedDate.toISOString()}>
			{parsedDate.toLocaleDateString('pt-BR', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			})}
		</time>
	) : (
		<span>---</span>
	)
}
